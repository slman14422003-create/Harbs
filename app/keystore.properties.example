# انسخ هذا الملف باسم keystore.properties (بجانبه، نفس المجلد app/) وعبّئ
# القيم الحقيقية. app/build.gradle.kts يقرأه تلقائياً — لن تحتاج لمس أي
# ملف gradle بعد ذلك مهما بنيت إصدارات جديدة.
#
# لإنشاء المفتاح أول مرة (مرة واحدة فقط طوال عمر التطبيق — لا تُعِد إنشاءه
# بعدها أبداً، وإلا فقد أي تحديث مستقبلي القدرة على التثبيت فوق النسخة
# الحالية لدى المستخدمين):
#   keytool -genkeypair -v -keystore herbal-release.jks -alias herbal \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# احفظ ملف .jks الناتج في مكان آمن خارج المستودع (لا تَرفعه أبداً لـ git —
# app/*.jks مُستثنى أصلاً في .gitignore).

storeFile=herbal-release.jks
storePassword=CHANGE_ME
keyAlias=herbal
keyPassword=CHANGE_ME
