<?xml version="1.0" encoding="utf-8"?>
<!--
    خلفية الأيقونة المتكيّفة (Adaptive Icon) — كانت لوناً مسطّحاً واحداً
    (@color/ic_launcher_background). هذه النسخة تعطي إحساس "زجاجي" عبر
    تدرّج شعاعي بلونين من هوية التطبيق + فقاعتين شبه شفافتين تحاكيان
    انعكاس الضوء على سطح زجاجي.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="40"
                android:centerY="34"
                android:gradientRadius="95"
                android:startColor="#2E8B4F"
                android:centerColor="#1B5E20"
                android:endColor="#0F3D16" />
        </aapt:attr>
    </path>

    <!-- فقاعة زجاجية علوية يسرى -->
    <path
        android:pathData="M20,26 m-30,0 a30,30 0,1 1,60 0 a30,30 0,1 1,-60 0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.10" />

    <!-- فقاعة زجاجية سفلى يمنى، أصغر -->
    <path
        android:pathData="M86,90 m-20,0 a20,20 0,1 1,40 0 a20,20 0,1 1,-40 0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.06" />
</vector>
