<?xml version="1.0" encoding="utf-8"?>
<!--
    مقدّمة الأيقونة المتكيّفة: كتاب جلدي مغلق تخرج من بين صفحاته ورقة/عشبة
    خضراء صغيرة كإشارة مرجعية (بدل شجرة كاملة) — تعبير أوضح عن "موسوعة"
    (كتاب) تحتوي معرفة عن "الأعشاب" (الورقة)، بطبقة زجاج سائل فوق الغلاف
    (شعاع لمعان قطري + نقطتا توهّج) تربط أيقونة التطبيق بهوية الزجاج
    السائل المستخدمة داخله (شريط علوي/أزرار/بطاقات).
    كل المجموعة تُمال قليلاً (-6°) لإحساس ثلاثي الأبعاد أكثر حيوية من
    شكل مسطّح تماماً.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="57"
        android:rotation="-6">

        <!-- الورقة الخضراء الخارجة من بين الصفحات (تُرسم أولاً كي يغطي
             الكتاب قاعدتها فتبدو وكأنها مغروزة داخله فعلاً). -->
        <path
            android:pathData="M54,4 C61,14 66,24 54,34 C42,24 47,14 54,4 Z"
            android:fillColor="#66BB6A" />
        <path
            android:pathData="M54,8 L54,31"
            android:strokeColor="#2E7D32"
            android:strokeWidth="1.3"
            android:fillColor="#00000000" />

        <!-- ظل سمك الكتاب (يعطي إحساس صفحات/غلاف مجلّد من الخلف). -->
        <path
            android:pathData="M35,27 L79,27 a6,6 0 0 1 6,6 L85,85 a6,6 0 0 1 -6,6 L35,91 a6,6 0 0 1 -6,-6 L29,33 a6,6 0 0 1 6,-6 Z"
            android:fillColor="#4E342E" />

        <!-- الغلاف الجلدي الرئيسي. -->
        <path
            android:pathData="M32,24 L76,24 a6,6 0 0 1 6,6 L82,82 a6,6 0 0 1 -6,6 L32,88 a6,6 0 0 1 -6,-6 L26,30 a6,6 0 0 1 6,-6 Z"
            android:fillColor="#6D4C41" />

        <!-- ظل داخلي عند حافة الغلاف اليسرى (خط التجليد/الشيرازة). -->
        <path
            android:pathData="M28,24.6 a5.6,5.6 0 0 0 -2.6,5.4 L26,64 L34,64 L34,24 Z"
            android:fillColor="#4E342E"
            android:fillAlpha="0.45" />

        <!-- شريط حواف الصفحات على الجانب الأيمن. -->
        <path
            android:pathData="M73,27 L78,27 a2,2 0 0 1 2,2 L80,83 a2,2 0 0 1 -2,2 L73,85 Z"
            android:fillColor="#FFF3E0" />

        <!-- شعاع لمعان زجاجي قطري فوق الغلاف. -->
        <path
            android:pathData="M28,40 L50,24 L80,30 L58,48 Z"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.18" />

        <!-- نقطتا توهّج زجاجي صغيرتان. -->
        <path
            android:pathData="M64,34 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.43" />
        <path
            android:pathData="M70.5,41 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.35" />
    </group>
</vector>
