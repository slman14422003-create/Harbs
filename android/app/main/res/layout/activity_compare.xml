<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_primary"
        android:titleTextColor="@color/white"
        app:title="@string/compare_title"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white" />

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/compare_need_two"
            android:textColor="@color/brand_primary_dark"
            android:gravity="center" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/compareContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/firstHerbSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp" />

                <Spinner
                    android:id="@+id/secondHerbSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/firstHerbName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary_dark"
                    android:textSize="16sp"
                    tools:text="عشبة أ" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚖️"
                    android:layout_gravity="center"
                    android:paddingHorizontal="8dp" />

                <TextView
                    android:id="@+id/secondHerbName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary_dark"
                    android:textSize="16sp"
                    tools:text="عشبة ب" />

            </LinearLayout>

            <TextView style="@style/CompareRowTitle" android:layout_marginTop="18dp" android:text="@string/section_benefits" />
            <LinearLayout style="@style/CompareRowContainer">
                <TextView android:id="@+id/benefitsFirst" style="@style/CompareRowValue" tools:text="—" />
                <TextView android:id="@+id/benefitsSecond" style="@style/CompareRowValue" tools:text="—" />
            </LinearLayout>

            <TextView style="@style/CompareRowTitle" android:text="@string/section_warnings" />
            <LinearLayout style="@style/CompareRowContainer">
                <TextView android:id="@+id/warningsFirst" style="@style/CompareRowValue" tools:text="—" />
                <TextView android:id="@+id/warningsSecond" style="@style/CompareRowValue" tools:text="—" />
            </LinearLayout>

            <TextView style="@style/CompareRowTitle" android:text="@string/section_harms" />
            <LinearLayout style="@style/CompareRowContainer">
                <TextView android:id="@+id/harmsFirst" style="@style/CompareRowValue" tools:text="—" />
                <TextView android:id="@+id/harmsSecond" style="@style/CompareRowValue" tools:text="—" />
            </LinearLayout>

            <TextView style="@style/CompareRowTitle" android:text="@string/section_usage" />
            <LinearLayout style="@style/CompareRowContainer">
                <TextView android:id="@+id/usageFirst" style="@style/CompareRowValue" tools:text="—" />
                <TextView android:id="@+id/usageSecond" style="@style/CompareRowValue" tools:text="—" />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
